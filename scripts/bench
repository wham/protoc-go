#!/bin/bash
# Performance harness: C++ protoc vs Go protoc-go.
#
# This is the perf counterpart to scripts/test (which checks correctness). It
# runs both compilers on the same corpus — the size-scaled generated tiers plus
# the vendored upstream protobuf corpus, which is what real-world .proto
# actually looks like — under controlled conditions (serial, warmed up,
# repeated) and reports per-case latency with its spread (±stddev), the Go/C++
# ratio, and a noise-aware verdict so that run-to-run jitter is never mistaken
# for a real win.
#
# Fairness rules baked into this harness:
#   * Every measurement reports stddev, not just a point estimate.
#   * Each row's noise-aware verdict is recorded in bench.json (not the human
#     tables, which show the raw ratios instead): a row is only called "go"
#     (Go faster) or "cpp" (C++ faster) when the medians differ by MORE than
#     both the combined stddev (run-to-run noise) and a relative margin
#     (--margin, default 3%). Otherwise it is a "tie". A difference inside
#     the noise is NOT a win for anyone.
#   * The startup_empty row measures pure process-launch cost, not compilation,
#     so it is flagged "informational" and excluded from win/loss aggregation.
#     Starting up faster is not the same as compiling faster.
#   * A row is timed only when both compilers compile it cleanly. A failed
#     compile is not a measurement of compiling, and the two give up at
#     different points, so a failing row would time two error paths against
#     each other. Rows that cannot compile are dropped and reported.
#   * hyperfine is strongly preferred. The built-in fallback timer has ~1ms
#     resolution, which is unreliable for the sub-30ms rows; verdicts from it
#     should not be trusted (and scripts that certify a winner, e.g. lisa.sh,
#     require hyperfine).
#   * Each timed row also reports peak memory (max RSS) for both compilers,
#     read from the kernel's rusage accounting — GNU/BSD time when available,
#     otherwise a python3 getrusage fallback reading the same counter. It
#     covers the whole invocation, so the plugin variant includes the
#     protoc-gen-dump subprocess on both sides (same binary, so still fair).
#
# Usage:
#   scripts/bench                 # default corpus + variants, human table
#   scripts/bench --summary       # just the table, no per-case progress
#   scripts/bench --runs 15       # measured runs per case (default 10)
#   scripts/bench --warmup 3      # warmup runs per case (default 3)
#   scripts/bench --margin 0.03   # relative "tie" margin (default 0.03 = 3%)
#   scripts/bench --sizes "tiny small medium large"   # which scaled tiers
#   scripts/bench --mem-runs 3    # peak-RSS runs per case (default 3, 0 = off)
#
# Outputs results-bench/bench.json (machine-readable, one object per
# case/variant with verdict + stddev + peak RSS) and results-bench/bench.md.
#
# Requires Go. C++ protoc is optional: if absent, only Go numbers are reported.
# If `hyperfine` is on PATH it drives the CLI timing (better statistics);
# otherwise a built-in median-of-N loop is used (verdicts unreliable).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TESTS_DIR="$PROJECT_DIR/testdata"
OUT_DIR="$PROJECT_DIR/results-bench"

PROTOC_GO="$PROJECT_DIR/cmd/protoc-go/protoc-go"
PROTOC_GEN_DUMP="$PROJECT_DIR/tools/protoc-gen-dump/protoc-gen-dump"

# -- flags ----------------------------------------------------------------

SUMMARY_ONLY=false
RUNS=10
WARMUP=3
MARGIN=0.03
SIZES="tiny small medium"
MEM_RUNS=3
while [ $# -gt 0 ]; do
  case "$1" in
    --summary)  SUMMARY_ONLY=true; shift ;;
    --runs)     RUNS="$2"; shift 2 ;;
    --warmup)   WARMUP="$2"; shift 2 ;;
    --margin)   MARGIN="$2"; shift 2 ;;
    --sizes)    SIZES="$2"; shift 2 ;;
    --mem-runs) MEM_RUNS="$2"; shift 2 ;;
    *) echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

# -- locate C++ protoc (non-fatal; find-protoc exits hard, so detect inline) --

PROTOC=""
if [ -x "/tmp/protoc-install/bin/protoc" ]; then
  PROTOC="/tmp/protoc-install/bin/protoc"
elif command -v protoc >/dev/null 2>&1; then
  PROTOC="$(command -v protoc)"
fi

PROTOC_INCLUDE=""
for d in /opt/homebrew/include /usr/local/include /tmp/protoc-install/include /usr/include; do
  if [ -d "$d/google/protobuf" ]; then PROTOC_INCLUDE="$d"; break; fi
done
INC_FLAG=""
[ -n "$PROTOC_INCLUDE" ] && INC_FLAG="-I$PROTOC_INCLUDE"

# -- locate a peak-RSS reader (non-fatal; columns read n/a without one) ----
# All three read the same kernel counter (ru_maxrss via wait4), which folds in
# every waited-for descendant — so the plugin variant includes the plugin
# subprocess. GNU time reports kbytes, BSD time bytes, python3 whatever
# getrusage says for the platform (KB on Linux, bytes on macOS).

MEM_TOOL=""
TIME_BIN=""
for tb in /usr/bin/time /opt/homebrew/bin/gtime /usr/local/bin/gtime; do
  [ -x "$tb" ] || continue
  if "$tb" -v true >/dev/null 2>&1; then MEM_TOOL="gnu-time"; TIME_BIN="$tb"; break; fi
  if "$tb" -l true >/dev/null 2>&1; then MEM_TOOL="bsd-time"; TIME_BIN="$tb"; break; fi
done
if [ -z "$MEM_TOOL" ] && command -v python3 >/dev/null 2>&1; then
  MEM_TOOL="python3-rusage"
fi
[ "$MEM_RUNS" -gt 0 ] || MEM_TOOL=""

# -- setup ----------------------------------------------------------------

echo "Building protoc-go..."
(cd "$PROJECT_DIR" && go build -o "$PROTOC_GO" ./cmd/protoc-go/) || exit 1
echo "Building protoc-gen-dump..."
(cd "$PROJECT_DIR" && go build -o "$PROTOC_GEN_DUMP" ./tools/protoc-gen-dump/) || exit 1

if [ -n "$PROTOC" ]; then
  echo "C++ protoc: $PROTOC ($("$PROTOC" --version))"
else
  echo "C++ protoc: NOT FOUND — reporting Go protoc-go numbers only (no verdicts)."
fi
if command -v hyperfine >/dev/null 2>&1; then
  echo "Timing driver: hyperfine ($(hyperfine --version))"
  USE_HYPERFINE=true
  DRIVER="hyperfine"
  RELIABLE=true
else
  USE_HYPERFINE=false
  DRIVER="builtin-median-$RUNS"
  RELIABLE=false
  echo "Timing driver: built-in median-of-${RUNS} (hyperfine not found)"
  echo "WARNING: the built-in timer has ~1ms resolution. Verdicts on sub-30ms"
  echo "         rows are unreliable — a 'tie' or 'go'/'cpp' call there is noise."
  echo "         Install hyperfine before trusting any verdict (and before using"
  echo "         this harness to certify that one compiler beats the other)."
fi
if [ -n "$MEM_TOOL" ]; then
  echo "Memory driver: $MEM_TOOL (peak RSS, median of $MEM_RUNS runs)"
else
  echo "Memory driver: none — peak-RSS columns will read n/a"
fi
echo "Runs: $RUNS  Warmup: $WARMUP  Tie margin: $MARGIN"
echo ""

# Ensure the scaled corpus exists (generated, gitignored).
for size in $SIZES; do
  if [ ! -f "$TESTS_DIR/bench/$size/test.proto" ]; then
    echo "Generating corpus tier: $size"
    "$SCRIPT_DIR/gen-large-stress" "$size" >/dev/null
  fi
done

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"
ROWS_JSONL="$OUT_DIR/rows.jsonl"
: > "$ROWS_JSONL"

# -- corpus ---------------------------------------------------------------
# Format: case_label|directory|sources (sources optional, default *.proto —
# a glob relative to the directory, so a case may be a whole tree)
# Mixes a couple of real fixtures with the scaled tiers so the report shows a
# clean size→latency curve (where algorithmic differences surface).

CASES=(
  "startup_empty|$TESTS_DIR/330_empty_proto"
  "01_basic_message|$TESTS_DIR/01_basic_message"
)
for size in $SIZES; do
  CASES+=("bench_$size|$TESTS_DIR/bench/$size")
done
CASES+=("329_large_stress|$TESTS_DIR/329_large_stress")

# The vendored upstream corpus (testdata/google/, see AGENTS.md) compiled in a
# single invocation: 53 real .proto files written by the protobuf maintainers,
# not by this project or its generator. It is the one row here whose shape —
# a dependency graph of imports and public imports, custom options, extensions,
# editions, generic services — is what a real project hands a compiler, so it is
# the row that says something about real-world performance. It needs the C++
# protoc include directory (four files import google/protobuf/cpp_features.proto
# or java_features.proto), and the guard below drops the row rather than time a
# failed compile when that is missing.
CASES+=("google_corpus|$TESTS_DIR/google|google/protobuf/*.proto")

# Variants: how each compiler is invoked.
#   descriptor — pure compile + serialize, no plugin/disk noise
#   plugin     — adds the protoc-gen-dump subprocess round-trip (the realistic
#                mode: protoc almost always drives a protoc-gen-* plugin)
VARIANTS="descriptor plugin"

# -- timing helpers -------------------------------------------------------

now_ms() { perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000'; }

# stats_builtin <cmd> — run WARMUP+RUNS times,
# echo "median stddev mean driver" (ms).
stats_builtin() {
  local cmd="$1" i s
  for ((i=0; i<WARMUP; i++)); do eval "$cmd" >/dev/null 2>&1; done
  local times=()
  for ((i=0; i<RUNS; i++)); do
    s=$(now_ms)
    eval "$cmd" >/dev/null 2>&1
    times+=( $(( $(now_ms) - s )) )
  done
  printf '%s\n' "${times[@]}" | sort -n | awk -v runs="$RUNS" '
    {a[NR]=$1; sum+=$1}
    END{
      n=NR; med=a[int((n+1)/2)]; mean=sum/n; ss=0;
      for(i=1;i<=n;i++){d=a[i]-mean; ss+=d*d}
      sd=(n>1)?sqrt(ss/(n-1)):0;
      printf "%.2f %.2f %.2f builtin-median-%d\n", med, sd, mean, runs
    }'
}

# stats_hyperfine <cmd> — echo "median stddev mean driver" (ms) via hyperfine
# JSON, or "" on failure so the caller can fall back. The command string uses
# shell syntax (subshell, cd, &&) so hyperfine must run it through a shell:
# -N/--shell=none would fail to exec it at all, and that failure used to be
# swallowed by the fallback while the row stayed labeled "hyperfine".
# hyperfine measures and subtracts the shell-spawn overhead itself.
stats_hyperfine() {
  local cmd="$1" jf="$OUT_DIR/.hf.json"
  hyperfine --warmup "$WARMUP" --runs "$RUNS" --export-json "$jf" "$cmd" \
    >/dev/null 2>&1 || { echo ""; return; }
  jq -r '.results[0] | [ (.median*1000), (.stddev*1000), (.mean*1000) ] | @tsv' "$jf" \
    | { tr '\t' ' '; } | sed 's/$/ hyperfine/'
}

# stats <cmd> — echo "median stddev mean driver" (ms); prefers hyperfine. The
# driver token reports what actually timed this measurement: a hyperfine
# failure falls back to the builtin loop and says so, per measurement.
stats() {
  local out=""
  if [ "$USE_HYPERFINE" = true ]; then
    out=$(stats_hyperfine "$1")
    [ -n "$out" ] || out=$(stats_builtin "$1")
  else
    out=$(stats_builtin "$1")
  fi
  echo "$out"
}

# peak_rss_kb_once <cmd> — one run, echo peak RSS in KB (nothing on failure).
# The command's own output is discarded inside the inner shell so that only the
# measuring tool's report reaches the pipe.
peak_rss_kb_once() {
  local cmd="$1"
  case "$MEM_TOOL" in
    gnu-time)
      "$TIME_BIN" -v sh -c "$cmd >/dev/null 2>&1" 2>&1 >/dev/null \
        | awk '/Maximum resident set size/ {print $NF}'
      ;;
    bsd-time)
      "$TIME_BIN" -l sh -c "$cmd >/dev/null 2>&1" 2>&1 >/dev/null \
        | awk '/maximum resident set size/ {print int($1/1024)}'
      ;;
    python3-rusage)
      # The forked shell starts out sharing python's resident pages, so the
      # smallest rows read a few MB high under this fallback. Fine for an
      # informational column, but GNU/BSD time is preferred for that reason.
      python3 - "$cmd" <<'PY'
import resource, subprocess, sys
subprocess.run(["sh", "-c", sys.argv[1] + " >/dev/null 2>&1"])
kb = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
print(kb // 1024 if sys.platform == "darwin" else kb)
PY
      ;;
  esac
}

# peak_rss_kb <cmd> — median peak RSS in KB over MEM_RUNS runs, or "" when
# memory cannot be measured. Peak RSS is far more stable than wall-clock, so a
# short median is enough to shrug off a one-off outlier.
peak_rss_kb() {
  local cmd="$1" i kb vals=()
  [ -n "$MEM_TOOL" ] || { echo ""; return; }
  for ((i=0; i<MEM_RUNS; i++)); do
    kb=$(peak_rss_kb_once "$cmd")
    [[ "$kb" =~ ^[0-9]+$ ]] && vals+=("$kb")
  done
  [ "${#vals[@]}" -gt 0 ] || { echo ""; return; }
  printf '%s\n' "${vals[@]}" | sort -n | awk '{a[NR]=$1} END{print a[int((NR+1)/2)]}'
}

# verdict <go_med> <go_sd> <cpp_med> <cpp_sd> — echo go|cpp|tie. Recorded in
# bench.json for machine consumers (lisa.sh, the README tally), not shown in
# the human tables. "tie" unless the medians differ by more than BOTH the
# combined stddev (run-to-run noise) AND a relative margin. This refuses to
# call noise a win.
verdict() {
  awk -v gm="$1" -v gs="$2" -v cm="$3" -v cs="$4" -v margin="$MARGIN" 'BEGIN{
    diff=gm-cm; ad=(diff<0)?-diff:diff;
    noise=gs+cs; relm=margin*cm; thr=(noise>relm)?noise:relm;
    if(ad<=thr){print "tie"; exit}
    print (diff<0)?"go":"cpp"
  }'
}

# build_cmd <impl> <variant> <dir> <sources> — emit the shell command string.
build_cmd() {
  local bin="$1" variant="$2" dir="$3" sources="$4"
  case "$variant" in
    descriptor)
      echo "(cd '$dir' && '$bin' --descriptor_set_out=/dev/null $INC_FLAG -I. $sources)"
      ;;
    plugin)
      local od="$OUT_DIR/dump_$(basename "$dir")_$(basename "$bin")"
      mkdir -p "$od"
      echo "(cd '$dir' && '$bin' --plugin=protoc-gen-dump='$PROTOC_GEN_DUMP' --dump_out='$od' --dump_opt='$od' $INC_FLAG -I. $sources)"
      ;;
  esac
}

# compiles_ok <cmd> — run the command once and report whether it exited 0.
# Every timed row is gated on this for both compilers: a failed compile is not
# a measurement of compiling, and the two give up at different points, so a
# failing row would be timing two different error paths against each other.
compiles_ok() {
  eval "$1" >/dev/null 2>&1
}

# -- run ------------------------------------------------------------------

printf '%-18s %-11s %14s %14s %7s %9s %9s %7s\n' "case" "variant" "cpp ms(±sd)" "go ms(±sd)" "go/cpp" "cpp MB" "go MB" "go/cpp"
printf '%-18s %-11s %14s %14s %7s %9s %9s %7s\n' "----" "-------" "-----------" "----------" "------" "------" "-----" "------"

ROWS_MD=()
FALLBACK_ROWS=0
SKIPPED_ROWS=()
for spec in "${CASES[@]}"; do
  IFS='|' read -r label dir sources_glob <<< "$spec"
  [ -d "$dir" ] || continue
  sources=$(cd "$dir" && ls ${sources_glob:-*.proto} 2>/dev/null | sort | tr '\n' ' ')
  [ -n "$sources" ] || continue

  # startup_empty measures process launch, not compilation: informational only.
  info=false
  [ "$label" = "startup_empty" ] && info=true

  for variant in $VARIANTS; do
    go_cmd=$(build_cmd "$PROTOC_GO" "$variant" "$dir" "$sources")
    cpp_cmd=""
    [ -n "$PROTOC" ] && cpp_cmd=$(build_cmd "$PROTOC" "$variant" "$dir" "$sources")

    # Gate on a clean compile before spending any time measuring one.
    skip_why=""
    compiles_ok "$go_cmd" || skip_why="Go protoc-go exits non-zero"
    if [ -z "$skip_why" ] && [ -n "$cpp_cmd" ] && ! compiles_ok "$cpp_cmd"; then
      skip_why="C++ protoc exits non-zero"
    fi
    if [ -n "$skip_why" ]; then
      SKIPPED_ROWS+=("$label/$variant: $skip_why")
      printf '%-18s %-11s %14s %14s %7s %9s %9s %7s\n' "$label" "$variant" "-" "-" "skip" "-" "-" "-"
      continue
    fi

    read -r go_med go_sd go_mean go_driver <<< "$(stats "$go_cmd")"
    go_disp=$(awk -v m="$go_med" -v s="$go_sd" 'BEGIN{printf "%d±%d", m+0.5, s+0.5}')

    go_mem_kb=$(peak_rss_kb "$go_cmd")
    go_mem_disp="n/a"; go_mem_json=null
    if [ -n "$go_mem_kb" ]; then
      go_mem_disp=$(awk -v k="$go_mem_kb" 'BEGIN{printf "%.1f", k/1024}')
      go_mem_json=$go_mem_kb
    fi
    cpp_mem_kb=""
    [ -n "$PROTOC" ] && cpp_mem_kb=$(peak_rss_kb "$cpp_cmd")
    cpp_mem_disp="n/a"; cpp_mem_json=null
    if [ -n "$cpp_mem_kb" ]; then
      cpp_mem_disp=$(awk -v k="$cpp_mem_kb" 'BEGIN{printf "%.1f", k/1024}')
      cpp_mem_json=$cpp_mem_kb
    fi
    mem_ratio_disp="n/a"; mem_ratio_json=null
    if [ -n "$go_mem_kb" ] && [ -n "$cpp_mem_kb" ] && [ "$cpp_mem_kb" -gt 0 ]; then
      mem_ratio_json=$(awk -v g="$go_mem_kb" -v c="$cpp_mem_kb" 'BEGIN{printf "%.2f", g/c}')
      mem_ratio_disp=$mem_ratio_json
    fi

    if [ -n "$PROTOC" ]; then
      read -r cpp_med cpp_sd cpp_mean cpp_driver <<< "$(stats "$cpp_cmd")"
      cpp_disp=$(awk -v m="$cpp_med" -v s="$cpp_sd" 'BEGIN{printf "%d±%d", m+0.5, s+0.5}')
      ratio=$(awk -v g="$go_med" -v c="$cpp_med" 'BEGIN{ if(c>0) printf "%.2f", g/c; else print "n/a" }')
      verd=$(verdict "$go_med" "$go_sd" "$cpp_med" "$cpp_sd")
      # A row is only as reliable as its weaker measurement: both sides must
      # have been timed by hyperfine for the row to count as hyperfine-timed.
      if [ "$go_driver" = "hyperfine" ] && [ "$cpp_driver" = "hyperfine" ]; then
        row_driver="hyperfine"; row_reliable=true
      else
        row_driver="builtin-median-$RUNS"; row_reliable=false
        FALLBACK_ROWS=$((FALLBACK_ROWS + 1))
      fi
      printf '{"case":"%s","variant":"%s","informational":%s,"cpp_ms":%.2f,"cpp_sd":%.2f,"go_ms":%.2f,"go_sd":%.2f,"ratio":%s,"verdict":"%s","driver":"%s","reliable":%s,"runs":%s,"cpp_peak_kb":%s,"go_peak_kb":%s,"mem_ratio":%s}\n' \
        "$label" "$variant" "$info" "$cpp_med" "$cpp_sd" "$go_med" "$go_sd" "$ratio" "$verd" "$row_driver" "$row_reliable" "$RUNS" "$cpp_mem_json" "$go_mem_json" "$mem_ratio_json" >> "$ROWS_JSONL"
    else
      cpp_disp="n/a"; ratio="n/a"; verd="n/a"
      if [ "$go_driver" = "hyperfine" ]; then
        row_driver="hyperfine"; row_reliable=true
      else
        row_driver="builtin-median-$RUNS"; row_reliable=false
        [ "$USE_HYPERFINE" = true ] && FALLBACK_ROWS=$((FALLBACK_ROWS + 1))
      fi
      printf '{"case":"%s","variant":"%s","informational":%s,"cpp_ms":null,"cpp_sd":null,"go_ms":%.2f,"go_sd":%.2f,"ratio":null,"verdict":"n/a","driver":"%s","reliable":%s,"runs":%s,"cpp_peak_kb":null,"go_peak_kb":%s,"mem_ratio":null}\n' \
        "$label" "$variant" "$info" "$go_med" "$go_sd" "$row_driver" "$row_reliable" "$RUNS" "$go_mem_json" >> "$ROWS_JSONL"
    fi

    printf '%-18s %-11s %14s %14s %7s %9s %9s %7s\n' "$label" "$variant" "$cpp_disp" "$go_disp" "$ratio" "$cpp_mem_disp" "$go_mem_disp" "$mem_ratio_disp"
    ROWS_MD+=("| $label | $variant | $cpp_disp | $go_disp | $ratio | $cpp_mem_disp | $go_mem_disp | $mem_ratio_disp |")
  done
done

# -- write machine-readable + markdown ------------------------------------

jq -s '.' "$ROWS_JSONL" > "$OUT_DIR/bench.json"

{
  echo "# Performance: C++ protoc vs Go protoc-go"
  echo ""
  if [ -n "$PROTOC" ]; then
    echo "- C++ protoc: \`$("$PROTOC" --version)\`"
  else
    echo "- C++ protoc: not available (Go-only run, no verdicts)"
  fi
  echo "- Go: \`$(go version | awk '{print $3, $4}')\`"
  echo "- Driver: $DRIVER, warmup=$WARMUP, runs=$RUNS, tie-margin=$MARGIN"
  if [ -n "$MEM_TOOL" ]; then
    echo "- Memory: peak RSS via $MEM_TOOL, median of $MEM_RUNS runs"
  else
    echo "- Memory: not measured (no GNU/BSD time or python3 found)"
  fi
  if [ "$RELIABLE" != true ]; then
    echo "- **WARNING:** built-in ~1ms timer — verdicts on sub-30ms rows are noise."
  fi
  echo ""
  echo "| case | variant | cpp ms(±sd) | go ms(±sd) | go/cpp | cpp peak MB | go peak MB | go/cpp |"
  echo "| ---- | ------- | ----------- | ---------- | ------ | ----------- | ---------- | ------ |"
  printf '%s\n' "${ROWS_MD[@]}"
  if [ "${#SKIPPED_ROWS[@]}" -gt 0 ]; then
    echo ""
    echo "Not measured (a compile that fails is not a measurement of compiling):"
    echo ""
    printf -- '- %s\n' "${SKIPPED_ROWS[@]}"
  fi
} > "$OUT_DIR/bench.md"

echo ""
if [ "$USE_HYPERFINE" = true ] && [ "$FALLBACK_ROWS" -gt 0 ]; then
  echo "WARNING: $FALLBACK_ROWS row(s) fell back to the builtin ~1ms timer because"
  echo "         hyperfine failed to run the command. Those rows are marked"
  echo "         driver=builtin/reliable=false in bench.json and their verdicts"
  echo "         should not be trusted or published."
fi
if [ "${#SKIPPED_ROWS[@]}" -gt 0 ]; then
  echo "WARNING: ${#SKIPPED_ROWS[@]} row(s) skipped — they did not compile cleanly:"
  printf '         %s\n' "${SKIPPED_ROWS[@]}"
fi
echo "Wrote $OUT_DIR/bench.json and $OUT_DIR/bench.md"
