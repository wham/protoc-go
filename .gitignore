# Binaries
cmd/protoc-go/protoc-go
tools/protoc-gen-dump/protoc-gen-dump
tools/protoc-bin/protoc
tools/protoc-bin/include/

# Test results
results/

# Stray protoc-gen-dump artifacts written into testdata case subdirs
# (e.g. testdata/<case>/<dump_opt>/). These belong in results/ and must
# never be committed. Legit examples live directly in testdata/<case>/.
testdata/*/*/request.json
testdata/*/*/request.pb
testdata/*/*/summary.txt

# Same artifacts, written into the repo root by scripts/test. Their contents
# shift whenever the binary is rebuilt (prototext varies its spacing on
# purpose), so tracking them makes the compliance workflow's "unexpected
# changes" guard fail at random.
/request.json
/request.pb
/summary.txt
/cpp_stderr.tmp

# Performance harness: generated corpus + results
testdata/bench/
results-bench/

# OS files
.DS_Store

# Editor files
.idea/
*.swp
*~

# Status file is tracked
!status.txt
bin/
